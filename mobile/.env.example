# Copy to mobile/.env (git-ignored). Expo exposes EXPO_PUBLIC_* variables to the app bundle,
# so never put secrets here.
#
# Base URL of the FastAPI backend (no trailing slash):
# - Web or iOS simulator on this computer: http://localhost:8000
# - Android emulator: http://10.0.2.2:8000
# - Physical phone (Expo Go): http://<this computer's LAN IP>:8000, and start the backend
#   with `uvicorn app.main:app --host 0.0.0.0 --port 8000`
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Maps SDK keys for development/store builds only (not needed in Expo Go or on web).
# Read by app.config.js at build time; they are not EXPO_PUBLIC_ and not in the JS bundle.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
