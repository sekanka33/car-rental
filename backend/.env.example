# Copy to backend/.env and adjust. Never commit backend/.env.
# Values below are placeholders. Put real credentials only in your local .env.

# development | test | staging | production
APP_ENV=development
APP_NAME=Car Rental API
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (admin dashboard, Expo web).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# PostgreSQL (required). With docker compose, use the values from the repository-root .env.
DATABASE_URL=postgresql+psycopg://car_rental:change-me-local-dev-password@localhost:5433/car_rental
# Separate database used by pytest. Tests DROP and recreate its schema — never point at real data.
TEST_DATABASE_URL=postgresql+psycopg://car_rental:change-me-local-dev-password@localhost:5433/car_rental_test
DATABASE_ECHO=false

# Authentication (required). Generate a long random key — never reuse the example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-random-key-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30

# Email. "console" logs emails instead of sending them (development only; refused in
# production). "smtp" sends through any provider that offers SMTP with STARTTLS.
EMAIL_BACKEND=console
EMAIL_FROM=CarHire SA <no-reply@example.com>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Links in emails start with APP_LINK_BASE_URL (the mobile app's deep-link scheme).
APP_LINK_BASE_URL=carrental://
