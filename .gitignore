# Secrets — never commit real environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Expo / Vite
node_modules/
.expo/
dist/
web-build/
build/
*.tsbuildinfo
npm-debug.log*

# Native build output (Expo prebuild / continuous native generation)
mobile/ios/
mobile/android/

# Local uploads (private documents must never be committed)
backend/storage/
uploads/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
